---
/**
 * Compact dock of section icons, the one in view in gold, on the right edge (default) or along the
 * bottom. Not shown at first; scrolling down keeps it away, scrolling up brings it out.
 * - Tap: nearby sections scroll into view. One more than two away goes through a veil: it blooms
 *   out of the icon, a title card names the section, then it opens in a circle from the same icon
 *   while the page glides the last stretch into place.
 * - Slide a finger along it: like holding a scrollbar, the page scrolls with the finger, no veil.
 * PUBLIC_NAVBAR=false in .env turns it off; PUBLIC_NAVBAR_POSITION=right|bottom places it (both
 * read at build time).
 */
import { wedding } from '@/content/wedding';
import { SOUND_ICONS } from '@/lib/soundIcons';

const enabled = import.meta.env.PUBLIC_NAVBAR !== 'false';
const hasMusic = Boolean(wedding.settings.music);
const position = import.meta.env.PUBLIC_NAVBAR_POSITION === 'bottom' ? 'bottom' : 'right';

/** The title card shown on a long jump uses each section's own heading, as written on the page. */
const TITLES: Record<string, { kh: string; en: string }> = {
  date: { kh: 'ថ្ងៃមង្គល', en: 'Save the date' },
  letter: { kh: 'សិរីមង្គលអាពាហ៍ពិពាហ៍', en: 'The invitation' },
  gallery: { kh: 'កម្រងរូបភាព', en: 'Gallery' },
  program: { kh: 'កម្មវិធីពិធីមង្គលការ', en: 'Order of ceremony' },
  venue: { kh: 'ទីតាំងពិធី', en: 'Venue' },
  wishes: { kh: 'សៀវភៅជូនពរ', en: 'Wishes for the couple' },
};

const ITEMS = [
  { id: 'date', kh: 'ថ្ងៃ', en: 'Date', icon: '<rect x="4" y="5" width="16" height="15" rx="2.5"/><path d="M4 10h16M8.5 3v4M15.5 3v4"/>' },
  { id: 'letter', kh: 'លិខិត', en: 'Letter', icon: '<rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="m3.5 7.5 8.5 6 8.5-6"/>' },
  { id: 'gallery', kh: 'រូបភាព', en: 'Photos', icon: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="9" cy="10" r="1.7"/><path d="m21 15.5-5-5-9 8.5"/>' },
  { id: 'program', kh: 'កម្មវិធី', en: 'Program', icon: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>' },
  { id: 'venue', kh: 'ទីតាំង', en: 'Map', icon: '<path d="M12 21s-6.5-5.7-6.5-10.5a6.5 6.5 0 0 1 13 0C18.5 15.3 12 21 12 21z"/><circle cx="12" cy="10.5" r="2.3"/>' },
  { id: 'wishes', kh: 'ជូនពរ', en: 'Wishes', icon: '<path d="M12 20s-7.5-4.6-7.5-10.3A4.2 4.2 0 0 1 12 7.2a4.2 4.2 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z"/>' },
];
---
{enabled && (
  <nav class="dock" aria-label="Sections" data-dock data-pos={position}>
    {ITEMS.map((it) => (
      <a href={`#${it.id}`} class="item" style={`--i:${ITEMS.indexOf(it)}`} data-target={it.id} data-title-kh={TITLES[it.id].kh} data-title-en={TITLES[it.id].en} aria-label={`${it.kh} · ${it.en}`}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" set:html={it.icon} />
      </a>
    ))}
    {hasMusic && (
      <>
        {/* The music switch, set apart from the sections by a small gold divider. */}
        <span class="sep" style={`--i:${ITEMS.length}`} aria-hidden="true"></span>
        <button type="button" class="item sound" style={`--i:${ITEMS.length + 1}`} data-sound data-icon="on" aria-label="Mute music" hidden>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" data-icon-svg set:html={SOUND_ICONS.on} />
        </button>
      </>
    )}
  </nav>
  <div class="veil" data-veil aria-hidden="true">
    <div class="veil-inner">
      <!-- The section's heading, as on the page: its icon between the gold rules, Khmer title, English line. -->
      <div class="veil-plaque" data-veil-plaque>
        <div class="veil-orn" data-veil-orn>
          <div class="pair"><div class="rule-fade-r l1"></div><div class="rule-fade-r l2"></div></div>
          <svg class="veil-icon" viewBox="0 0 24 24" data-veil-icon></svg>
          <div class="pair"><div class="rule-fade-l l1"></div><div class="rule-fade-l l2 right"></div></div>
        </div>
        <span class="veil-name" data-veil-name></span>
        <span class="veil-en" data-veil-en></span>
      </div>
    </div>
  </div>
)}

<style>
  /* Showing: the pill springs out, then its icons pop in one by one. Hiding: the icons shrink away
     last first and the pill folds into a dot. */
  .dock {
    --hide: translate(-50%, 0) scale(.25);
    --place: translate(-50%, 0);
    --n: 8;
    /* Above the kbach rails (54), which it sits on when on the right. */
    position: fixed; z-index: 56; left: 50%; bottom: calc(14px + env(safe-area-inset-bottom, 0px));
    display: flex; align-items: center; gap: 1px; padding: 3px;
    border-radius: 999px; border: 1px solid rgba(217, 164, 65, 0.45);
    background: rgba(44, 5, 16, 0.5);
    -webkit-backdrop-filter: blur(12px) saturate(1.3); backdrop-filter: blur(12px) saturate(1.3);
    box-shadow: 0 10px 28px rgba(20, 2, 6, 0.45), inset 0 1px 0 rgba(244, 218, 155, 0.12);
    transform: var(--hide); opacity: 0; pointer-events: none;
    transition: transform 260ms cubic-bezier(0.5, 0, 0.75, 0) 180ms, opacity 200ms ease 240ms;
  }
  /* On the right: a vertical pill over the kbach rail, in the middle of the screen. */
  .dock[data-pos='right'] {
    --hide: translate(0, -50%) scale(.25);
    --place: translate(0, -50%);
    flex-direction: column; left: auto; bottom: auto; top: 50%;
    right: calc(max(0px, (100vw - var(--page-max)) / 2) + max(4px, (var(--rail) - 38px) / 2));
  }
  .dock[data-show] {
    transform: var(--place); opacity: 1; pointer-events: auto;
    transition: transform 480ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 160ms ease;
  }
  .dock[data-show][data-away] {
    transform: var(--hide); opacity: 0; pointer-events: none;
    transition: transform 260ms cubic-bezier(0.5, 0, 0.75, 0) 180ms, opacity 200ms ease 240ms;
  }

  .item {
    display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%;
    color: var(--gold-pale); -webkit-tap-highlight-color: transparent;
    transform: scale(0);
    transition: background-color 300ms ease, color 300ms ease,
      transform 160ms ease-in calc((var(--n) - 1 - var(--i)) * 30ms);
  }
  .dock[data-show]:not([data-away]) .item {
    transform: none;
    transition: background-color 300ms ease, color 300ms ease,
      transform 420ms cubic-bezier(0.34, 1.8, 0.64, 1) calc(140ms + var(--i) * 45ms);
  }
  .item svg { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; opacity: .75; }
  .item[aria-current] { color: var(--wine-900); background: linear-gradient(180deg, #F8E3AE, var(--gold)); }
  .item[aria-current] svg { opacity: 1; }

  /* The music switch and its divider. */
  .sep { flex: none; width: 14px; height: 1px; margin: 3px auto; background: var(--gold-a55); transform: scale(0); transition: transform 160ms ease-in; }
  .dock[data-pos='bottom'] .sep { width: 1px; height: 14px; margin: auto 3px; }
  .dock[data-show]:not([data-away]) .sep { transform: none; transition: transform 300ms ease calc(140ms + var(--i) * 45ms); }
  .sound { border: 0; padding: 0; background: transparent; cursor: pointer; font: inherit; }
  .sound[hidden] { display: none; }
  .sound[data-icon='off'] svg { opacity: .55; }
  .sound :global(.bar) { transform-box: fill-box; transform-origin: bottom; animation: dance 900ms ease-in-out infinite alternate; }
  .sound :global(.b2) { animation-duration: 700ms; animation-delay: -300ms; }
  .sound :global(.b3) { animation-duration: 1100ms; animation-delay: -600ms; }
  @keyframes dance { from { transform: scaleY(.35); } to { transform: scaleY(1); } }
  /* Sliding: the finger owns the dock (no page scroll), and the icon under it swells. */
  .dock { touch-action: none; }
  /* While sliding: no glass blur to repaint every frame, and icons react at once (no pop-in stagger). */
  .dock[data-show][data-sliding] { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(44, 5, 16, 0.62); }
  .dock[data-show][data-sliding]:not([data-away]) .item { transition: background-color 120ms ease, color 120ms ease, transform 160ms ease; }
  /* While sliding, the icon under the finger (the section in view) swells. */
  .dock[data-show][data-sliding]:not([data-away]) .item[data-under] { transform: scale(1.28); box-shadow: 0 0 14px rgba(244, 218, 155, 0.55); }
  .item:focus-visible { outline: 1px solid var(--gold-lt); outline-offset: 2px; }

  /* The veil for long jumps: wine with a whisper of damask, the section's name in gold. */
  .veil {
    /* Over the kbach rails (54) too; under the dock (56). */
    position: fixed; inset: 0; z-index: 55; display: none; place-items: center; pointer-events: none;
    background: radial-gradient(90% 70% at 50% 50%, #7A1A2C, var(--wine-900) 60%, var(--wine-950));
  }
  .veil::before {
    content: ''; position: absolute; inset: 0; background: #A23447; opacity: .14;
    -webkit-mask: url('/assets/damask-mask.png') center / 320px auto repeat;
    mask: url('/assets/damask-mask.png') center / 320px auto repeat;
  }
  .veil[data-on] { display: grid; }
  /* The opening: a hole of radius --hole around the tapped icon (--hx, --hy) shows the section through. */
  .veil[data-opening] {
    -webkit-mask: radial-gradient(circle at var(--hx) var(--hy), transparent var(--hole), #000 calc(var(--hole) + 1px));
    mask: radial-gradient(circle at var(--hx) var(--hy), transparent var(--hole), #000 calc(var(--hole) + 1px));
  }
  @property --hole { syntax: '<length>'; inherits: false; initial-value: 0px; }
  /* The title card, in the site's own heading style. Hidden until the veil has spread; the script
     plays each piece in. */
  .veil-inner { position: relative; opacity: 0; }
  .veil-plaque {
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    max-width: calc(100vw - 80px); text-align: center;
  }
  /* The double gold rules and diamond from the section headings. */
  .veil-orn { display: flex; align-items: center; gap: 12px; }
  .veil-orn .pair { display: flex; flex-direction: column; gap: 4px; }
  .veil-orn .l1 { width: 48px; }
  .veil-orn .l2 { width: 28px; margin-left: auto; opacity: .57; }
  .veil-orn .l2.right { margin-left: 0; }
  .veil-orn .pair:first-child > * { transform-origin: right; }
  .veil-orn .pair:last-child > * { transform-origin: left; }
  .veil-icon {
    width: 24px; height: 24px; fill: none; stroke: var(--gold-lt); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round;
    filter: drop-shadow(0 0 6px rgba(244, 218, 155, 0.5));
  }
  .veil-name {
    font-family: var(--kh-font); font-size: 21px; line-height: 1.7; color: var(--gold-lt);
    text-shadow: 0 2px 0 rgba(44, 5, 16, 0.6), 0 0 16px rgba(217, 164, 65, 0.25);
  }
  .veil-en {
    font-family: var(--en-font); font-size: 9.5px; letter-spacing: 0.3em; padding-left: 0.3em; text-transform: uppercase;
    color: var(--gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .dock, .item { transition: none; }
  }
</style>

<script>
  import { onOpened } from '@/lib/events';
  import { REVEAL_ALL_EVENT } from '@/scripts/reveal';
  import { music } from '@/lib/music';
  import { SOUND_ICONS } from '@/lib/soundIcons';

  /** Scrolled less than this from the top, the dock stays tucked away. */
  const TOP_PX = 120;

  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) {
    const items = Array.from(dock.querySelectorAll<HTMLAnchorElement>('[data-target]'));
    const sections = items
      .map((a) => document.getElementById(a.dataset.target!))
      .filter((el): el is HTMLElement => el !== null);

    // Highlight the section crossing the middle of the screen.
    const mark = (id: string) => items.forEach((a) => a.toggleAttribute('aria-current', a.dataset.target === id));
    const sync = () => {
      const mid = window.innerHeight / 2;
      const here = sections.find((s) => { const r = s.getBoundingClientRect(); return r.top <= mid && r.bottom > mid; });
      if (here) mark(here.id);
    };

    // While a tap scrolls the page, the tapped icon stays lit and the dock stays put; the
    // sections passed on the way don't light up. Once scrolling has been quiet for a moment,
    // the highlight follows the page again.
    let steering = false;
    let quiet = 0;
    // On arrival the tapped section keeps the highlight (a short one may not reach the middle of
    // the screen); the next real scroll takes over again.
    const settleSoon = (ms: number) => {
      clearTimeout(quiet);
      quiet = window.setTimeout(() => { if (!sliding) steering = false; }, ms);
    };
    /** True while a finger is sliding along the dock. */
    let sliding = false;

    const io = new IntersectionObserver((entries) => {
      if (steering) return;
      for (const e of entries) if (e.isIntersecting) mark(e.target.id);
    }, { rootMargin: '-45% 0px -50% 0px' });
    sections.forEach((s) => io.observe(s));

    const veil = document.querySelector<HTMLElement>('[data-veil]');
    const veilName = document.querySelector<HTMLElement>('[data-veil-name]');
    const veilEn = document.querySelector<HTMLElement>('[data-veil-en]');
    const veilPlaque = document.querySelector<HTMLElement>('[data-veil-plaque]');
    const veilOrn = document.querySelector<HTMLElement>('[data-veil-orn]');
    const veilIcon = document.querySelector<SVGElement>('[data-veil-icon]');

    /** Plays the title card in: the icon appears, the rules draw out from it, the heading rises, the
     *  English settles. Resolves when it has all landed.
     *  `both`: delayed pieces stay hidden through their delay instead of showing, then snapping back. */
    const playCard = (inner: HTMLElement) => {
      const ease = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
      const rules = veilOrn!.querySelectorAll('.pair > *');
      inner.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 180, fill: 'forwards' });
      const steps = [
        veilPlaque!.animate([{ transform: 'scale(.96)' }, { transform: 'none' }], { duration: 380, easing: ease, fill: 'both' }),
        veilIcon!.animate([
          { opacity: 0, transform: 'scale(.6)' },
          { opacity: 1, transform: 'none' },
        ], { duration: 320, delay: 40, easing: ease, fill: 'both' }),
        ...Array.from(rules, (l) => l.animate([{ transform: 'scaleX(0)' }, { transform: 'none' }], {
          duration: 320, delay: 100, easing: ease, fill: 'both',
        })),
        veilName!.animate([
          { opacity: 0, transform: 'translateY(8px)' },
          { opacity: 1, transform: 'none' },
        ], { duration: 320, delay: 120, easing: 'cubic-bezier(0.25, 0.1, 0.25, 1)', fill: 'both' }),
        veilEn!.animate([
          { opacity: 0, letterSpacing: '0.6em' },
          { opacity: 1, letterSpacing: '0.3em' },
        ], { duration: 320, delay: 160, easing: ease, fill: 'both' }),
      ];
      return Promise.all(steps.map((s) => s.finished));
    };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    /** Jumping more sections away than this goes through the veil instead of a long scroll. */
    const MAX_STEPS = 2;
    let veiling = false;
    /** Behind the veil the page lands this far short of the section, and glides the rest as it opens. */
    const GLIDE_PX = 140;

    /** Scrolls from `from` to `to` over `ms`, easing out like the end of a long scroll. */
    const glide = (from: number, to: number, ms: number) => new Promise<void>((done) => {
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / ms);
        window.scrollTo({ top: from + (to - from) * (1 - (1 - t) ** 3), behavior: 'instant' });
        if (t < 1) requestAnimationFrame(step); else done();
      };
      requestAnimationFrame(step);
    });

    /** Blooms the veil out of the tapped icon, names the section, jumps, then lifts the veil. */
    const veilTo = async (a: HTMLAnchorElement, target: HTMLElement) => {
      if (!veil || !veilName || !veilEn || !veilPlaque || !veilOrn || !veilIcon) return;
      veiling = true;
      const icon = a.getBoundingClientRect();
      const x = icon.left + icon.width / 2;
      const y = icon.top + icon.height / 2;
      veilName.textContent = a.dataset.titleKh ?? '';
      veilEn.textContent = a.dataset.titleEn ?? '';
      veilIcon.innerHTML = a.querySelector('svg')?.innerHTML ?? '';
      veil.setAttribute('data-on', '');
      await veil.animate([{ clipPath: `circle(0% at ${x}px ${y}px)` }, { clipPath: `circle(150% at ${x}px ${y}px)` }], {
        duration: 300, easing: 'cubic-bezier(0.6, 0, 0.4, 1)', fill: 'forwards',
      }).finished;
      const inner = veil.querySelector<HTMLElement>('.veil-inner')!;
      await playCard(inner);
      // Land just short of the section, on the side we're coming from.
      const end = Math.min(target.getBoundingClientRect().top + window.scrollY, document.documentElement.scrollHeight - window.innerHeight);
      const down = end > window.scrollY;
      const landing = Math.max(0, end + (down ? -GLIDE_PX : GLIDE_PX));
      window.scrollTo({ top: landing, behavior: 'instant' });
      await new Promise((done) => setTimeout(done, 60));
      // Open on the section: a circle grows from the same icon while the page glides in.
      const reach = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
      veil.style.setProperty('--hx', `${x}px`);
      veil.style.setProperty('--hy', `${y}px`);
      veil.setAttribute('data-opening', '');
      inner.animate([{ opacity: 1 }, { opacity: 0, transform: 'scale(.94)' }], { duration: 180, easing: 'ease-in', fill: 'forwards' });
      await Promise.all([
        veil.animate([{ '--hole': '0px' }, { '--hole': `${reach}px` }], {
          duration: 380, easing: 'cubic-bezier(0.6, 0, 0.4, 1)', fill: 'forwards',
        }).finished,
        glide(landing, end, 480),
      ]);
      veil.removeAttribute('data-on');
      veil.removeAttribute('data-opening');
      // Reset every piece of the card for the next jump.
      veil.getAnimations({ subtree: true }).forEach((an) => an.cancel());
      veiling = false;
      settleSoon(150);
    };

    // Slide a finger along the dock like holding a scrollbar's thumb: where the finger is maps
    // to where the page is. Each icon's centre lines up with the top of its section, and in between
    // the page sits in between; the page eases there smoothly rather than jumping. No veil.
    // A tap stays a tap: the slide only starts once the finger has moved a little.
    let slide: { id: number; x: number; y: number; on: boolean } | null = null;
    let swallowClick = false;
    const vertical = dock.dataset.pos === 'right';
    /** Icon centres along the dock and their sections' tops, measured as the slide starts. */
    let stops: { at: number; top: number; item: HTMLAnchorElement }[] = [];
    /** Where the finger says the page should be; the page eases there a good part of the way each frame. */
    let goal = 0;
    let following = false;
    const follow = () => {
      const y = window.scrollY;
      const left = goal - y;
      if (Math.abs(left) < 1 && !sliding) {
        window.scrollTo({ top: goal, behavior: 'instant' });
        following = false;
        settleSoon(150);
        return;
      }
      if (Math.abs(left) >= 1) window.scrollTo({ top: y + left * 0.3, behavior: 'instant' });
      requestAnimationFrame(follow);
    };

    const measure = () => {
      const box = dock.getBoundingClientRect();
      const maxTop = document.documentElement.scrollHeight - window.innerHeight;
      // offset* ignore the swell transform, so the stops don't move as icons grow.
      stops = items.map((item) => ({
        item,
        at: vertical ? box.top + item.offsetTop + item.offsetHeight / 2 : box.left + item.offsetLeft + item.offsetWidth / 2,
        top: Math.min(maxTop, (document.getElementById(item.dataset.target!)?.getBoundingClientRect().top ?? 0) + window.scrollY),
      }));
    };
    /** The page position for a finger at `p` along the dock. */
    const topFor = (p: number) => {
      if (p <= stops[0].at) return stops[0].top;
      const last = stops[stops.length - 1];
      if (p >= last.at) return last.top;
      const i = stops.findIndex((s, k) => p >= s.at && p < stops[k + 1].at);
      const t = (p - stops[i].at) / (stops[i + 1].at - stops[i].at);
      return stops[i].top + t * (stops[i + 1].top - stops[i].top);
    };
    /** The icon nearest the finger. */
    const nearest = (p: number) => stops.reduce((a, b) => (Math.abs(b.at - p) < Math.abs(a.at - p) ? b : a)).item;

    dock.addEventListener('pointerdown', (e) => {
      if (veiling) return;
      slide = { id: e.pointerId, x: e.clientX, y: e.clientY, on: false };
    });
    dock.addEventListener('pointermove', (e) => {
      if (!slide || e.pointerId !== slide.id) return;
      if (!slide.on) {
        if (Math.hypot(e.clientX - slide.x, e.clientY - slide.y) < 8) return;
        slide.on = true;
        sliding = true;
        steering = true;
        dock.setPointerCapture(e.pointerId);
        dock.setAttribute('data-sliding', '');
        // Sections that haven't faded in yet would flash in and out as the page races past them.
        window.dispatchEvent(new Event(REVEAL_ALL_EVENT));
        measure();
      }
      const p = vertical ? e.clientY : e.clientX;
      goal = topFor(p);
      if (!following) { following = true; requestAnimationFrame(follow); }
      const it = nearest(p);
      if (!it.hasAttribute('data-under')) {
        mark(it.dataset.target!);
        items.forEach((x) => x.toggleAttribute('data-under', x === it));
        navigator.vibrate?.(6);
      }
    });
    const endSlide = (e: PointerEvent) => {
      if (!slide || e.pointerId !== slide.id) return;
      if (slide.on) {
        sliding = false;
        items.forEach((x) => x.removeAttribute('data-under'));
        // The click that may follow a slide isn't a tap (and may never come, so don't wait for it).
        swallowClick = true;
        setTimeout(() => { swallowClick = false; }, 300);
        dock.removeAttribute('data-sliding');
        if (!following) settleSoon(200);
      }
      slide = null;
    };
    dock.addEventListener('pointerup', endSlide);
    dock.addEventListener('pointercancel', endSlide);

    /** Goes to an icon's section: a smooth scroll when it's near, through the veil when it's far. */
    const go = (a: HTMLAnchorElement) => {
      const target = document.getElementById(a.dataset.target!);
      if (!target || veiling) return;
      const from = items.findIndex((x) => x.hasAttribute('aria-current'));
      const steps = Math.abs(items.indexOf(a) - Math.max(0, from));
      steering = true;
      mark(a.dataset.target!);
      dock.removeAttribute('data-away');
      if (steps > MAX_STEPS && !reduced) { void veilTo(a, target); return; }
      target.scrollIntoView({ behavior: reduced ? 'instant' : 'smooth', block: 'start' });
      settleSoon(400); // in case the page doesn't need to move at all
    };

    // Without adding #hash entries to the history.
    for (const a of items) {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        if (swallowClick) { swallowClick = false; return; }
        go(a);
      });
    }

    // Not shown at first. Scrolling down keeps it away; scrolling up brings it out (except at the
    // very top of the page).
    let opened = false;
    let lastY = window.scrollY;
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      if (steering) { lastY = y; if (!veiling) settleSoon(150); return; }
      if (Math.abs(y - lastY) < 8) return;
      dock.toggleAttribute('data-show', opened && y < lastY && y > TOP_PX);
      lastY = y;
    }, { passive: true });
    onOpened(() => { opened = true; });

    // The music switch: shows only when there's music; its icon follows the music's state.
    const sound = dock.querySelector<HTMLButtonElement>('[data-sound]');
    if (sound) {
      const svg = sound.querySelector('svg')!;
      const sep = dock.querySelector<HTMLElement>('.sep');
      music.subscribe((st) => {
        sound.hidden = !st.available;
        if (sep) sep.hidden = !st.available;
        const icon = st.muted ? 'off' : st.playing ? 'playing' : 'on';
        if (sound.dataset.icon !== icon) { sound.dataset.icon = icon; svg.innerHTML = SOUND_ICONS[icon]; }
        sound.setAttribute('aria-label', st.muted ? 'Turn music on' : 'Mute music');
      });
      sound.addEventListener('click', () => music.toggle());
      // A press on the switch isn't the start of a slide through the sections.
      sound.addEventListener('pointerdown', (e) => e.stopPropagation());
    }
  }
</script>
