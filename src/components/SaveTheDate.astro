---
import { wedding } from '@/content/wedding';
import { makeDust } from '@/lib/particles';
import { monogramSrc } from '@/lib/monogram';
import GuestCard from './islands/GuestCard';
import MonogramImage from './islands/MonogramImage';
import Photo from './Photo.astro';

const { couple, date, photos, settings } = wedding;
const dust = makeDust(settings.dustCount);
const mono = monogramSrc(settings.dateMonogram);
const khDigits = (v: string) => v.replace(/\d/g, (d) => '០១២៣៤៥៦៧៨៩'[Number(d)]);
const [weekdayKh, ...lunarRest] = date.lunarKh.split(' ');
---
<section id="date" class="date" data-opening>
  <div class="glow"></div>
  <div class="dust" aria-hidden="true">
    {dust.map((d) => (
      <span style={`left:${d.left};bottom:${d.bottom};animation:dust ${d.dur} linear ${d.delay} infinite`}></span>
    ))}
  </div>

  <div class="stack">
    <div class="kicker a-kicker">
      <div class="rule-fade-r kline"></div>
      <div class="en caps kick">Save the date</div>
      <div class="rule-fade-l kline"></div>
    </div>

    <div class="a-mono">
      {mono
        ? <MonogramImage client:load src={mono.src} className={mono.square ? 'mono-img square' : 'mono-img'} />
        : <div class="mono-type">M<span>&amp;</span>N</div>}
    </div>

    <div class="when">
      <div class="kh month a-month">ខែ{date.monthKh}</div>
      <div class="triple">
        <div class="kh side a-side-l">{weekdayKh}</div>
        <div class="kh day a-day">
          <span class="day-num" data-day={khDigits(date.day)}>{khDigits(date.day)}</span>
        </div>
        <div class="kh side a-side-r">ឆ្នាំ{date.yearKh}</div>
      </div>
      <div class="kh lunar a-lunar">{lunarRest.join(' ')}</div>
    </div>

    <div class="countdown" data-countdown={date.iso}>
      <div class="cd-head a-cdhead">
        <div class="rule-fade-r cd-line"></div>
        <div class="kh cd-title">រាប់ថយក្រោយ</div>
        <div class="rule-fade-l cd-line"></div>
      </div>
      <div class="cd-row">
        {([['d', 'ថ្ងៃ'], ['h', 'ម៉ោង'], ['m', 'នាទី'], ['s', 'វិនាទី']] as const).map(([k, kh], i) => (
          <div class="cd-cell a-cell" style={`--i:${i}`}>
            <div class="kh cd-num" data-cd={k}>--</div>
            <div class="kh cd-kh">{kh}</div>
          </div>
        ))}
      </div>
      <div class="kh cd-today" hidden>ថ្ងៃនេះជាថ្ងៃមង្គល</div>
    </div>

    <div class="a-card"><GuestCard client:load /></div>
  </div>

  <div class="story">
    <div data-sfx="turn" class="watermark" aria-hidden="true"></div>
    <div class="tile" aria-hidden="true"></div>
    <div class="edge top" aria-hidden="true"></div>
    <div class="edge bottom" aria-hidden="true"></div>
    <div class="en caps story-kick">The beginning of always</div>
    <div data-parallax="0.02" class="strip" style="transform:rotate(-4deg)">
      <div class="strip-paper">
        {photos.strip.map((src, i) => (
          <div class="strip-frame"><Photo src={src} label={`Strip ${i + 1}`} /></div>
        ))}
        <div class="strip-caption">
          <div class="en caps">{couple.short}</div>
          <div class="en">{date.dots}</div>
        </div>
      </div>
    </div>
    <div class="kh story-kh">រំលេចដំណើររឿងរបស់យើង</div>
  </div>
</section>

<style>
  .date {
    position: relative; background: var(--wine-900); padding: 72px var(--inset) 64px; overflow: hidden;
  }
  .glow { position: absolute; inset: 0; background: radial-gradient(90% 60% at 50% 45%, var(--wine-800) 0%, var(--wine-900) 70%); }
  .dust { position: absolute; inset: 0; overflow: hidden; }
  .dust span { position: absolute; width: 3px; height: 3px; border-radius: 50%; background: var(--gold); opacity: 0; }

  .stack { position: relative; display: flex; flex-direction: column; align-items: center; gap: 26px; text-align: center; }
  .kicker { display: flex; align-items: center; gap: 14px; }
  .kline { width: 38px; }
  .kick { font-size: 10px; letter-spacing: 0.32em; color: var(--gold); }

  .stack :global(.mono-img) { display: block; width: 172px; height: 242px; object-fit: contain; margin-bottom: -6px; }
  .when { display: flex; flex-direction: column; align-items: center; gap: 14px; width: 100%; }
  .month { font-size: 18px; color: var(--gold-lt); line-height: 1.6; }
  .triple { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18px; width: 100%; max-width: 300px; }
  .side {
    padding: 6px 0 5px; border-top: 1px solid var(--gold-a55); border-bottom: 1px solid var(--gold-a55);
    font-size: 14px; color: var(--gold-lt); text-align: center; line-height: 1.7;
  }
  .day { font-size: 60px; color: var(--gold-dk); line-height: 1.25; }
  .lunar { font-size: 12.5px; color: var(--gold-lt); opacity: .8; line-height: 1.8; }

  .countdown { display: flex; flex-direction: column; align-items: center; gap: 14px; width: 100%; margin-top: 6px; }
  .cd-head { display: flex; align-items: center; gap: 12px; }
  .cd-line { width: 30px; }
  .cd-title { font-size: 12px; color: var(--gold); opacity: .9; line-height: 1.7; }
  .cd-row { display: flex; align-items: flex-start; justify-content: center; }
  .cd-cell { position: relative; display: flex; flex-direction: column; align-items: center; width: 64px; }
  .cd-cell + .cd-cell::before {
    content: ''; position: absolute; left: -2.5px; top: 16px; width: 5px; height: 5px;
    transform: rotate(45deg); background: var(--gold-a55);
  }
  .cd-num { --reel-h: 1.5; font-size: 24px; color: var(--gold-lt); line-height: 1.5; height: 1.5em; }
  /* Digit reels, one per digit (built by the script). Every reel is the same width, so the
     numbers never shift sideways as digits change. Most Khmer digits are 0.63em wide, ២ ៣ ៧ up to 0.83em,
     so the reel only clips top and bottom and lets the wide ones spill a hair into the gap. */
  :is(.cd-num, .day-num) :global(.reel) {
    display: inline-block; width: 0.76em; height: calc(var(--reel-h) * 1em);
    clip-path: inset(0 -0.2em); vertical-align: top; text-align: center;
  }
  :is(.cd-num, .day-num) :global(.strip) { display: block; }
  :is(.cd-num, .day-num) :global(.strip > span) { display: block; height: calc(var(--reel-h) * 1em); margin: 0 -0.2em; white-space: nowrap; }
  .cd-kh { font-size: 11px; color: var(--gold); line-height: 1.6; opacity: .85; }
  .cd-today { font-size: 14px; color: var(--gold-lt); line-height: 1.8; }
  .countdown.is-today .cd-row { display: none; }
  .stack :global(.mono-img.square) { width: 108px; height: 108px; margin-bottom: 0; }
  .mono-type { font-family: var(--en-font); font-size: 64px; font-weight: 500; color: var(--gold); line-height: 1; letter-spacing: 0.02em; }
  .mono-type span { display: inline-block; margin: 0 -14px; font-size: 44px; transform: translateY(-6px); opacity: .9; }



  .story {
    position: relative; z-index: 6; margin: 44px auto 0; padding: 26px 0 24px;
    display: flex; flex-direction: column; align-items: center; gap: 18px;
  }
  .watermark {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 280px; height: 280px;
    background: url('/assets/monogram-khmer-gold.png') center / 78% no-repeat; opacity: .16; pointer-events: none;
  }
  .tile { position: absolute; inset: 0; background: url('/assets/kbach-rail-tile.png') center top / 64px repeat; opacity: .07; pointer-events: none; }
  .edge { position: absolute; left: 0; right: 0; height: 1px; background: linear-gradient(to right, var(--gold-0), var(--gold-a55), var(--gold-0)); }
  .edge.top { top: 0; }
  .edge.bottom { bottom: 0; }
  .story-kick { position: relative; font-size: 9.5px; letter-spacing: 0.3em; color: var(--gold); }
  .strip { position: relative; flex: 0 0 auto; width: 132px; will-change: transform; }
  .strip-paper {
    background: var(--cream); padding: 8px 8px 0; display: flex; flex-direction: column; gap: 6px;
    box-shadow: 0 14px 32px rgba(20, 3, 8, 0.6), 0 2px 0 rgba(255, 255, 255, 0.35) inset;
  }
  .strip-frame { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: #DED3C0; }
  .strip-caption { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 8px 0 10px; }
  .strip-caption div:first-child { font-size: 6px; letter-spacing: 0.2em; color: var(--wine-700); }
  .strip-caption div:last-child { font-size: 5.5px; letter-spacing: 0.18em; color: var(--tan); }
  .story-kh { position: relative; font-size: 11px; color: var(--gold-lt); opacity: .8; line-height: 2; }

  /* ---------- Opening: plays once, right after the cover's flash ---------- */
  .date[data-opening] { --t0: 100ms; }
  .date[data-opening]:not(.is-open) :is(.a-kicker, .a-mono, .a-month, .a-side-l, .a-side-r, .a-day, .a-lunar, .a-cdhead, .a-cell, .a-card) { opacity: 0; }
  .is-open .a-kicker .kline { animation: lineIn 900ms var(--ease) calc(var(--t0) + 0ms) both; }
  .is-open .a-kicker .kline:first-child { transform-origin: right; }
  .is-open .a-kicker .kline:last-child { transform-origin: left; }
  .is-open .a-kicker .kick { animation: spaceIn 1300ms var(--ease) calc(var(--t0) + 100ms) both; }
  /* The cover's monogram lands exactly here, so this one takes over at once with a flare. */
  .is-open .a-mono { animation: monoLand 1200ms ease-out 0ms both; }
  .is-open .a-month { animation: dropIn 800ms var(--ease) calc(var(--t0) + 950ms) both; }
  .is-open .a-side-l { animation: slideL 900ms var(--ease) calc(var(--t0) + 1200ms) both; }
  .is-open .a-side-r { animation: slideR 900ms var(--ease) calc(var(--t0) + 1200ms) both; }
  .is-open .a-day { animation: dayIn 1000ms var(--ease) calc(var(--t0) + 1150ms) both; }
  .is-open .a-day .day-num { animation: dayGlow 1600ms ease-out calc(var(--t0) + 1800ms) both; }
  .is-open .a-lunar { animation: fadeUp 800ms var(--ease) calc(var(--t0) + 1900ms) both; }
  .is-open .a-cdhead { animation: fadeUp 800ms var(--ease) calc(var(--t0) + 2100ms) both; }
  .is-open .a-cell { animation: flipIn 800ms var(--ease) calc(var(--t0) + 2250ms + var(--i) * 110ms) both; }
  .is-open .a-card { animation: fadeUp 1000ms var(--ease) calc(var(--t0) + 2750ms) both; }
  .date { --ease: cubic-bezier(0.16, 0.84, 0.28, 1); }
  /* The guest card's wrapper spans the column so the card can reach its full width. */
  .a-card { display: flex; justify-content: center; width: 100%; }

  @keyframes lineIn { from { transform: scaleX(0); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes spaceIn { from { opacity: 0; letter-spacing: 0.9em; filter: blur(3px); } to { opacity: 1; letter-spacing: 0.32em; filter: none; } }
  @keyframes monoLand {
    0% { opacity: 0; transform: scale(.85); filter: brightness(1.7) drop-shadow(0 0 14px rgba(244, 218, 155, 0.9)); }
    40% { opacity: 1; }
    100% { opacity: 1; transform: none; filter: none; }
  }
  @keyframes dropIn { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: none; } }
  @keyframes slideL { from { opacity: 0; transform: translateX(-36px); clip-path: inset(0 0 0 100%); } to { opacity: 1; transform: none; clip-path: inset(0); } }
  @keyframes slideR { from { opacity: 0; transform: translateX(36px); clip-path: inset(0 100% 0 0); } to { opacity: 1; transform: none; clip-path: inset(0); } }
  @keyframes dayIn { from { opacity: 0; transform: scale(1.6); filter: blur(8px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes dayGlow {
    0% { text-shadow: 0 0 0 rgba(244, 218, 155, 0); color: var(--gold-dk); }
    25% { text-shadow: 0 0 22px rgba(244, 218, 155, 0.9), 0 0 4px rgba(255, 245, 210, 0.9); color: var(--gold-lt); }
    100% { text-shadow: 0 0 0 rgba(244, 218, 155, 0); color: var(--gold-dk); }
  }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes flipIn { from { opacity: 0; transform: perspective(300px) rotateX(-90deg); } to { opacity: 1; transform: none; } }

  .day-num { --reel-h: 1.25; display: inline-block; height: 1.25em; }

  @media (prefers-reduced-motion: reduce) {
    .date[data-opening] :is(.a-kicker, .a-mono, .a-month, .a-side-l, .a-side-r, .a-day, .a-lunar, .a-cdhead, .a-cell, .a-card) { opacity: 1 !important; animation: none !important; }
  }
</style>

<script>
  import { onOpened } from '@/lib/events';

  // Each digit sits in its own fixed-width reel; every countdown tick rolls the changed digits
  // up like an odometer.
  const KH = '០១២៣៤៥៦៧៨៩';
  const kh = (v: string) => v.replace(/\d/g, (d) => KH[Number(d)]);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** A reel for each digit of `cell`, rebuilt if the number of digits changes. */
  const reels = (cell: HTMLElement, len: number) => {
    if (cell.children.length !== len || !cell.querySelector('.reel')) {
      cell.textContent = '';
      for (let i = 0; i < len; i++) {
        const reel = document.createElement('span');
        reel.className = 'reel';
        reel.innerHTML = '<span class="strip"><span></span></span>';
        cell.append(reel);
      }
    }
    return Array.from(cell.querySelectorAll<HTMLElement>('.strip'));
  };
  const fill = (strip: HTMLElement, chars: string[]) => {
    strip.innerHTML = chars.map((c) => `<span>${c}</span>`).join('');
  };
  /** Height of one digit in the reel, in em (the cell's --reel-h). */
  const lineH = (cell: HTMLElement) => parseFloat(getComputedStyle(cell).getPropertyValue('--reel-h')) || 1.5;

  /** Shows `value`; digits that changed roll up into place when `roll` is set. */
  const show = (cell: HTMLElement, value: string, roll: boolean) => {
    const strips = reels(cell, value.length);
    const h = lineH(cell);
    strips.forEach((strip, i) => {
      const prev = strip.dataset.v;
      const next = value[i];
      if (prev === next) return;
      strip.dataset.v = next;
      if (!roll || prev === undefined || reduced) { fill(strip, [next]); return; }
      fill(strip, [prev, next]);
      strip.animate([{ transform: 'translateY(0)' }, { transform: `translateY(-${h}em)` }],
        { duration: 380, easing: 'cubic-bezier(0.3, 0.7, 0.3, 1)' })
        .finished.then(() => { if (strip.dataset.v === next) fill(strip, [next]); }, () => {});
    });
  };

  /** When the entrance has finished building (its last piece ends ~3.85s in). */
  const SETTLED_MS = 3900;
  /** A still moment after the entrance before the first nudge. */
  const HINT_PAUSE_MS = 1500;
  /** How often the page nudges up to show there's more below, until the guest scrolls. */
  const HINT_EVERY_MS = 7000;

  /** Bounces the section and the one after it up a little, hinting that the page scrolls. */
  const hintScroll = (sec: HTMLElement) => {
    const els = [sec, sec.nextElementSibling].filter((el): el is HTMLElement => el instanceof HTMLElement);
    const nudge = () => els.forEach((el) => el.animate([
      { transform: 'none' },
      { transform: 'translateY(-28px)', offset: 0.3 },
      { transform: 'none', offset: 0.55 },
      { transform: 'translateY(-10px)', offset: 0.72 },
      { transform: 'none' },
    ], { duration: 2800, easing: 'ease-in-out' }));
    let timer = 0;
    const first = window.setTimeout(() => { nudge(); timer = window.setInterval(nudge, HINT_EVERY_MS); }, HINT_PAUSE_MS);
    const stop = () => { window.clearTimeout(first); window.clearInterval(timer); window.removeEventListener('scroll', stop); };
    window.addEventListener('scroll', stop, { passive: true });
    if (window.scrollY > 10) stop();
  };

  // Opening: once the cover is gone, play the entrance, then hint that the page scrolls.
  for (const sec of document.querySelectorAll<HTMLElement>('[data-opening]')) {
    const day = sec.querySelector<HTMLElement>('[data-day]');
    if (day) show(day, day.dataset.day!, false);
    onOpened(() => {
      sec.classList.add('is-open');
      if (!reduced) window.setTimeout(() => hintScroll(sec), SETTLED_MS);
    });
  }

  // Live countdown to the wedding; switches to a "today" line once the day arrives.
  for (const el of document.querySelectorAll<HTMLElement>('[data-countdown]')) {
    const target = new Date(el.dataset.countdown!).getTime();
    const cells = Object.fromEntries(
      Array.from(el.querySelectorAll<HTMLElement>('[data-cd]')).map((c) => [c.dataset.cd!, c]),
    );
    const pad = (n: number) => kh(String(n).padStart(2, '0'));
    const values = () => {
      const s = Math.floor((target - Date.now()) / 1000);
      return {
        d: kh(String(Math.floor(s / 86400))), h: pad(Math.floor(s / 3600) % 24),
        m: pad(Math.floor(s / 60) % 60), s: pad(s % 60),
      };
    };
    const tick = (roll = true) => {
      if (target - Date.now() <= 0) {
        el.classList.add('is-today');
        el.querySelector<HTMLElement>('.cd-today')!.hidden = false;
        clearInterval(timer);
        return;
      }
      const v = values();
      for (const k of ['d', 'h', 'm', 's'] as const) show(cells[k], v[k], roll);
    };
    const timer = setInterval(tick, 1000);
    tick(false);
  }
</script>
