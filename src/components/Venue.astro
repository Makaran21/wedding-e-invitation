---
import { wedding } from '@/content/wedding';
import VenueMap from './islands/VenueMap';
const { lat, lng, details } = wedding.venue;
const directions = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
---
<section id="venue" class="venue">
  <div class="orn" aria-hidden="true">
    <div class="rule-fade-r line"></div>
    <div class="dot"></div>
    <div class="box"></div>
    <div class="dot"></div>
    <div class="rule-fade-l line"></div>
  </div>
  <div data-reveal class="inner">
    <div class="section-title">
      <h2>ទីតាំងពិធី</h2>
      <div class="en">Venue</div>
    </div>

    <div class="map-block">
      <div class="map">
        <VenueMap client:visible />
        <div class="vignette" aria-hidden="true"></div>
      </div>
      <a class="directions" href={directions} target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z"></path><circle cx="12" cy="10" r="2.6"></circle></svg>
        <span class="en caps">Open directions</span>
      </a>
    </div>

    <div class="details">
      {details.map((v) => (
        <div class="detail">
          <div class="en caps d-en">{v.en}</div>
          <div class="kh d-kh">{v.kh}</div>
          <div class="kh d-body">{v.body}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .venue { background: var(--wine-800); padding: 0 var(--inset) 48px; }
  .orn { padding: 30px 0 0; display: flex; align-items: center; justify-content: center; gap: 9px; }
  .line { width: 48px; }
  .dot { width: 5px; height: 5px; flex: none; transform: rotate(45deg); background: var(--gold); opacity: .75; }
  .box { width: 9px; height: 9px; flex: none; transform: rotate(45deg); border: 1px solid var(--gold); }
  .inner { max-width: 520px; margin: 0 auto; padding: 34px 24px 0; display: flex; flex-direction: column; gap: 28px; }
  .section-title h2 { color: var(--gold-lt); }
  .section-title .en { color: var(--gold); }
  .map-block { display: flex; flex-direction: column; gap: 12px; }
  .map { position: relative; width: 100%; aspect-ratio: 16 / 10; border: 1px solid var(--gold-a45); border-radius: 14px; overflow: hidden; background: var(--wine-900); }
  .vignette { position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 0 60px rgba(44, 5, 16, 0.55); }
  .directions {
    align-self: center; display: flex; align-items: center; gap: 7px; padding: 8px 16px;
    border: 1px solid rgba(217, 164, 65, 0.5); border-radius: 999px; color: var(--gold); transition: background 200ms ease-out;
  }
  .directions:hover { background: rgba(217, 164, 65, 0.12); }
  .directions svg { display: block; flex: none; }
  .directions span { font-size: 8px; letter-spacing: 0.26em; }
  .details {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1px;
    background: var(--gold-a28); border-radius: 14px; overflow: hidden;
  }
  .detail { background: var(--wine-800); padding: 20px 16px; display: flex; flex-direction: column; gap: 8px; }
  .d-en { font-size: 8px; letter-spacing: 0.28em; color: var(--gold); }
  .d-kh { font-size: 12px; color: var(--gold-lt); line-height: 1.7; }
  .d-body { font-size: 12px; font-weight: 300; color: var(--blush); line-height: 1.9; }
</style>
