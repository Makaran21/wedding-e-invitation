---
import Program from './islands/Program';
---
<section id="program" class="program">
  <div class="orn" aria-hidden="true">
    <div class="pair">
      <div class="rule-fade-r l1"></div>
      <div class="rule-fade-r l2 soft"></div>
    </div>
    <div class="gem"></div>
    <div class="pair">
      <div class="rule-fade-l l1"></div>
      <div class="rule-fade-l l2 soft right"></div>
    </div>
  </div>
  <div data-reveal class="inner">
    <div class="section-title">
      <h2>កម្មវិធីពិធីមង្គលការ</h2>
      <div class="en">Order of ceremony</div>
    </div>
    <div><Program client:visible /></div>
  </div>
</section>

<style>
  .program { background: var(--wine-600); padding: 0 var(--inset) 46px; }
  .orn { padding: 30px 0 0; display: flex; align-items: center; justify-content: center; gap: 14px; }
  .pair { display: flex; flex-direction: column; gap: 4px; flex: none; }
  .l1 { width: 60px; }
  .l2 { width: 36px; margin-left: auto; }
  .l2.right { margin-left: 0; }
  .soft { opacity: .57; }
  .gem { width: 7px; height: 7px; flex: none; transform: rotate(45deg); background: var(--gold); }
  .inner { max-width: 520px; margin: 0 auto; padding: 26px 24px 0; display: flex; flex-direction: column; gap: 26px; }
  .inner > div:last-child { display: flex; flex-direction: column; gap: 26px; }
  .section-title h2 { color: var(--gold-lt); }
  .section-title .en { color: var(--gold); }
</style>
