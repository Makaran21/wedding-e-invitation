---
import Wishes from './islands/Wishes';
---
<section id="wishes" class="wishes">
  <div data-reveal class="inner">
    <div class="section-title">
      <h2>សៀវភៅជូនពរ</h2>
      <div class="en">Wishes for the couple</div>
    </div>
    <div class="island"><Wishes client:visible /></div>
  </div>
</section>

<style>
  .wishes { background: var(--cream); padding: 48px var(--inset-wide) 64px; }
  .inner { max-width: 520px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px; }
  .island { display: flex; flex-direction: column; gap: 24px; }
  .section-title h2 { color: var(--wine-600); }
  .section-title .en { color: var(--rose); }
</style>
