---
import { wedding } from '@/content/wedding';
const { couple, parents, parentsEn, letter } = wedding;
---
<section id="letter" class="letter">
  <div class="paper">
    <div class="grid" aria-hidden="true"></div>
    <div data-reveal class="body">
      <h2 class="kh heading">សិរីមង្គលអាពាហ៍ពិពាហ៍</h2>

      <!-- Khmer half, as printed on the top of the card -->
      <div class="kh parents">
        {parents.map((p) => <div>{p}</div>)}
      </div>

      <div class="kh honour">មានកិត្តិយសសូមគោរពអញ្ជើញ</div>

      <p class="kh invite-kh">{letter.inviteKh}</p>

      <div class="couple kh-row">
        <div class="who">
          <span class="kh role">កូនប្រុសនាម</span>
          <span class="kh name">{couple.groom.kh}</span>
        </div>
        <div class="kh pair">ជាគូនឹង</div>
        <div class="who">
          <span class="kh role">កូនស្រីនាម</span>
          <span class="kh name">{couple.bride.kh}</span>
        </div>
      </div>

      <p class="kh details-kh">{letter.detailsKh}</p>

      <div class="gold-rule"></div>

      <!-- English half, as printed on the bottom of the card -->
      <div class="en caps parents-en">
        {parentsEn.map((p) => <div>{p}</div>)}
      </div>

      <p class="en caps invite-en">{letter.inviteEn}</p>

      <div class="couple">
        <div class="who">
          <span class="en caps role-en">Groom</span>
          <span class="en caps name-en">{couple.groom.en}</span>
        </div>
        <div class="who">
          <span class="en caps role-en">Bride</span>
          <span class="en caps name-en">{couple.bride.en}</span>
        </div>
      </div>

      <div class="details-en">
        <div class="en caps held">Which will be held</div>
        <p class="en when">{letter.detailsEn}</p>
      </div>

      <div class="kh thanks">សូមអរគុណ</div>
    </div>
  </div>
</section>

<style>
  .letter { position: relative; background: var(--wine-800); padding: 0 var(--inset); }
  .paper { position: relative; overflow: hidden; background: radial-gradient(120% 90% at 50% 18%, var(--paper) 0%, var(--cream) 46%, var(--paper-dk) 100%); }
  .grid {
    position: absolute; inset: 0; opacity: .5;
    background: repeating-linear-gradient(90deg, rgba(142,27,46,0.05) 0 1px, transparent 1px 26px),
                repeating-linear-gradient(0deg, rgba(142,27,46,0.04) 0 1px, transparent 1px 26px);
  }
  .body {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: 22px; text-align: center;
    max-width: 520px; margin: 0 auto; padding: 60px 8px 56px;
  }
  .heading { font-size: 21px; line-height: 1.7; color: var(--wine-700); text-shadow: 0 0 1px rgba(217, 164, 65, 0.35); }
  .parents { display: grid; grid-template-columns: auto auto; justify-content: space-between; text-align: left; gap: 4px 18px; width: 100%; padding: 0 18px; font-size: 12.5px; color: var(--wine-700); line-height: 1.9; }
  .honour { font-size: 13px; color: var(--rose); line-height: 1.8; }
  .invite-kh { padding: 0 4px; font-size: 12.5px; line-height: 2; color: var(--wine-700); text-wrap: pretty; }
  .couple { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-items: start; width: 100%; padding: 4px 18px 0; }
  .couple > .who:first-child { justify-self: start; }
  .couple > .who:last-child { justify-self: end; }
  /* Groom · ជាគូនឹង · bride, with the same gap on each side of ជាគូនឹង. */
  .couple.kh-row { display: flex; justify-content: center; align-items: flex-end; gap: 22px; }
  .pair { font-size: 12.5px; color: var(--rose); line-height: 1.6; padding-bottom: 4px; }
  .who { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .role { font-size: 11px; color: var(--rust); letter-spacing: 0.04em; }
  .name { font-family: 'Khmer OS Muol Light', var(--kh-font); font-size: 14px; color: var(--gold-dk); line-height: 1.9; }
  .details-kh { padding: 0 18px; font-size: 12.5px; line-height: 2; color: var(--wine-700); text-wrap: pretty; }
  .gold-rule { width: 78%; height: 1px; background: linear-gradient(to right, transparent, rgba(217, 164, 65, 0.85), transparent); }
  .parents-en { display: grid; grid-template-columns: auto auto; justify-content: space-between; text-align: left; gap: 4px 18px; width: 100%; padding: 0 18px; font-size: 10.5px; letter-spacing: 0.06em; color: var(--wine-700); line-height: 1.7; }
  .invite-en { padding: 0 18px; font-size: 10.5px; line-height: 1.8; letter-spacing: 0.08em; color: var(--rust); text-wrap: balance; }
  .role-en { font-size: 9px; letter-spacing: 0.24em; color: var(--rust); }
  .name-en { font-size: 11px; letter-spacing: 0.06em; color: var(--wine-700); line-height: 1.5; white-space: nowrap; }
  .details-en { display: flex; flex-direction: column; gap: 6px; }
  .held { font-size: 9.5px; letter-spacing: 0.24em; color: var(--rust); }
  .when { font-size: 14px; line-height: 1.8; color: var(--rose); white-space: pre-line; }
  .thanks { font-size: 12px; color: var(--rose); line-height: 1.8; padding-top: 4px; }
</style>
