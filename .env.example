# Copy to .env, fill in, then rebuild / restart.

# The gold progress line along the bottom of the screen while the intro, the opening into
# Save the Date and sending a wish play. On unless set to false. (Read at build time.)
PUBLIC_ANIMATION_PROGRESS=true

# Secret part of the admin panel's address: https://your-site/<ADMIN_KEY>
# Make it long and random, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_KEY=

# Password asked on the admin panel before anything shows.
ADMIN_PASSWORD=

# true when the site runs behind Cloudflare (tunnel or proxy) or another reverse proxy,
# so each guest's real IP is used for the one-wish rule and rate limits.
TRUST_PROXY=false

# Where the SQLite database is kept.
DB_PATH=data/wishes.db

# Telegram: a bot posts each new wish to your group with Approve / Reject buttons.
# 1. Create a bot with @BotFather and paste its token here.
# 2. Add the bot to your group.
# 3. Put the group's chat id here (a negative number, e.g. -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
